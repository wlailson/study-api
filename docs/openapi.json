  "components": {
    "schemas": {
      "SubjectRequestDTO": {
        "type": "object",
        "description": "Dados para criação ou atualização de uma disciplina",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da disciplina",
            "example": "Java",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "SubjectResponseDTO": {
        "type": "object",
        "description": "Dados de uma disciplina",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID da disciplina",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nome da disciplina",
            "example": "Java"
          }
        }
      },
      "RevisionRequestDTO": {
        "type": "object",
        "properties": {
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "breakTimeInMinutes": {
            "type": "integer",
            "format": "int64"
          },
          "durationInMinutes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RevisionResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID da revisão",
            "example": 1
          },
          "topic": {
            "type": "string",
            "description": "Nome do tópico relacionado à revisão",
            "example": "Spring Boot"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date",
            "description": "Data programada para a revisão",
            "example": "2026-09-15"
          },
          "completedDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Data em que a revisão foi concluída",
            "example": "2026-09-15"
          },
          "durationInMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Tempo de estudo da revisão em minutos",
            "example": 60
          },
          "breakTimeInMinutes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Tempo de intervalo em minutos",
            "example": 10
          },
          "status": {
            "type": "string",
            "description": "Status atual da revisão",
            "enum": [
              "PENDING",
              "COMPLETED"
            ],
            "example": "COMPLETED"
          }
        }
      },
      "UserRequestDTO": {
        "type": "object",
        "description": "Credenciais utilizadas para autenticação",
        "properties": {
          "email": {
            "type": "string",
            "description": "E-mail cadastrado do usuário",
            "example": "maria@gmail.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Senha do usuário",
            "example": "123456"
          }
        }
      },
      "StudySessionRequestDTO": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Tópico estudado durante a sessão",
            "example": "Herança em Java",
            "maxLength": 100,
            "minLength": 0
          },
          "durationInMinutes": {
            "type": "integer",
            "format": "int64",
            "description": "Duração da sessão em minutos",
            "example": 60,
            "minimum": 0
          },
          "breakTimeInMinutes": {
            "type": "integer",
            "format": "int64",
            "description": "Tempo total de pausas durante a sessão em minutos",
            "example": 10,
            "minimum": 0
          },
          "revisions": {
            "type": "array",
            "description": "Lista de revisões associadas à sessão",
            "items": {
              "$ref": "#/components/schemas/RevisionRequestDTO"
            }
          }
        },
        "required": [
          "breakTimeInMinutes",
          "durationInMinutes",
          "topic"
        ]
      },
      "ClientDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID do cliente",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nome do cliente",
            "example": "Maria Silva"
          }
        }
      },
      "StudySessionResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "ID da sessão de estudo",
            "example": 1
          },
          "durationInMinutes": {
            "type": "integer",
            "format": "int64",
            "description": "Duração da sessão de estudo em minutos",
            "example": 60
          },
          "breakTimeInMinutes": {
            "type": "integer",
            "format": "int64",
            "description": "Tempo total de pausas durante a sessão em minutos",
            "example": 10
          },
          "topic": {
            "$ref": "#/components/schemas/TopicResponseDTO",
            "description": "Tópico estudado durante a sessão",
            "example": "Herança em Java"
          },
          "client": {
            "$ref": "#/components/schemas/ClientDTO",
            "description": "Usuário associado à sessão de estudo"
          },
          "subject": {
            "$ref": "#/components/schemas/SubjectResponseDTO",
            "description": "Disciplina estudada durante a sessão"
          },
